# Copy this file to `.env` and fill in your Firebase project's web-app values
# (Firebase console → Project settings → Your apps → Web app → SDK setup).
# The app runs in built-in demo mode until VITE_FIREBASE_API_KEY and
# VITE_FIREBASE_PROJECT_ID are both set.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Canonical / OG / sitemap base URL (defaults to the Vercel production domain).
# Override with a custom domain, e.g. https://dept-of-ca.pvkngovtchittoor.ac.in
VITE_SITE_URL=
